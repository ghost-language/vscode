{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Ghost",
	"scopeName": "source.ghost",
	"fileTypes": ["gs", "ghost"],

	"patterns": [
		{ "include": "#code" }
	],

	"repository": {
		"code": {
			"patterns": [
				{ "include": "#comments" },
				{ "include": "#strings" },
				{ "include": "#import" },
				{ "include": "#class" },
				{ "include": "#trait" },
				{ "include": "#use" },
				{ "include": "#function-declaration" },
				{ "include": "#method-declaration" },
				{ "include": "#switch" },
				{ "include": "#keywords" },
				{ "include": "#constants" },
				{ "include": "#numbers" },
				{ "include": "#new" },
				{ "include": "#library" },
				{ "include": "#function-call" },
				{ "include": "#property-access" },
				{ "include": "#operators" },
				{ "include": "#punctuation" },
				{ "include": "#identifier" }
			]
		},

		"comments": {
			"patterns": [
				{
					"name": "comment.block.ghost",
					"begin": "/\\*",
					"beginCaptures": {
						"0": { "name": "punctuation.definition.comment.begin.ghost" }
					},
					"end": "\\*/",
					"endCaptures": {
						"0": { "name": "punctuation.definition.comment.end.ghost" }
					}
				},
				{
					"name": "comment.line.double-slash.ghost",
					"begin": "//",
					"beginCaptures": {
						"0": { "name": "punctuation.definition.comment.ghost" }
					},
					"end": "$"
				},
				{
					"name": "comment.line.number-sign.ghost",
					"begin": "#",
					"beginCaptures": {
						"0": { "name": "punctuation.definition.comment.ghost" }
					},
					"end": "$"
				}
			]
		},

		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.ghost",
					"begin": "\"",
					"beginCaptures": {
						"0": { "name": "punctuation.definition.string.begin.ghost" }
					},
					"end": "\"",
					"endCaptures": {
						"0": { "name": "punctuation.definition.string.end.ghost" }
					},
					"patterns": [
						{ "include": "#string-escapes" }
					]
				},
				{
					"name": "string.quoted.single.ghost",
					"begin": "'",
					"beginCaptures": {
						"0": { "name": "punctuation.definition.string.begin.ghost" }
					},
					"end": "'",
					"endCaptures": {
						"0": { "name": "punctuation.definition.string.end.ghost" }
					},
					"patterns": [
						{ "include": "#string-escapes" }
					]
				},
				{ "include": "#template-string" }
			]
		},

		"template-string": {
			"comment": "Backtick template literal with ${expr} interpolation. Interpolations and nested templates balance their own braces via #template-brace/#template-string, matching the scanner's brace-depth tracking.",
			"name": "string.template.ghost",
			"begin": "`",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.string.begin.ghost" }
			},
			"end": "`",
			"endCaptures": {
				"0": { "name": "punctuation.definition.string.end.ghost" }
			},
			"patterns": [
				{ "include": "#string-escapes" },
				{ "include": "#template-interpolation" }
			]
		},

		"template-interpolation": {
			"name": "meta.embedded.line.ghost",
			"begin": "\\$\\{",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.template-expression.begin.ghost" }
			},
			"end": "\\}",
			"endCaptures": {
				"0": { "name": "punctuation.definition.template-expression.end.ghost" }
			},
			"patterns": [
				{ "include": "#template-string" },
				{ "include": "#template-brace" },
				{ "include": "#code" }
			]
		},

		"template-brace": {
			"comment": "Balances a nested { } (a map literal, a block) inside an interpolation, so the first } belonging to it doesn't close the interpolation early.",
			"begin": "\\{",
			"beginCaptures": {
				"0": { "name": "punctuation.section.braces.ghost" }
			},
			"end": "\\}",
			"endCaptures": {
				"0": { "name": "punctuation.section.braces.ghost" }
			},
			"patterns": [
				{ "include": "#template-string" },
				{ "include": "#template-brace" },
				{ "include": "#code" }
			]
		},

		"string-escapes": {
			"patterns": [
				{
					"comment": "The scanner recognises exactly these escapes; anything else is kept verbatim, backslash included.",
					"name": "constant.character.escape.ghost",
					"match": "\\\\[nrt\\\\\"']"
				},
				{
					"name": "constant.character.format.placeholder.ghost",
					"match": "%[sdvqxXtbcofeEgGp%]"
				}
			]
		},

		"import": {
			"patterns": [
				{
					"comment": "import Name, Other as Alias from \"path\"",
					"begin": "\\b(import)\\b",
					"beginCaptures": {
						"1": { "name": "keyword.control.import.ghost" }
					},
					"end": "(?<=[\"'])|$",
					"patterns": [
						{ "include": "#comments" },
						{ "include": "#strings" },
						{
							"name": "keyword.control.import.ghost",
							"match": "\\b(from|as)\\b"
						},
						{
							"name": "variable.language.wildcard.ghost",
							"match": "\\*"
						},
						{
							"name": "entity.name.type.imported.ghost",
							"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
						},
						{ "include": "#punctuation" }
					]
				}
			]
		},

		"class": {
			"comment": "class Name extends Super {",
			"match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(extends)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
			"captures": {
				"1": { "name": "storage.type.class.ghost" },
				"2": { "name": "entity.name.type.class.ghost" },
				"3": { "name": "storage.modifier.extends.ghost" },
				"4": { "name": "entity.other.inherited-class.ghost" }
			}
		},

		"trait": {
			"match": "\\b(trait)\\s+([A-Za-z_][A-Za-z0-9_]*)",
			"captures": {
				"1": { "name": "storage.type.trait.ghost" },
				"2": { "name": "entity.name.type.trait.ghost" }
			}
		},

		"use": {
			"comment": "use TraitOne, TraitTwo",
			"begin": "\\b(use)\\b",
			"beginCaptures": {
				"1": { "name": "keyword.control.use.ghost" }
			},
			"end": "$|(?=[^\\s,A-Za-z0-9_])",
			"patterns": [
				{
					"name": "entity.name.type.trait.ghost",
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
				},
				{
					"name": "punctuation.separator.comma.ghost",
					"match": ","
				}
			]
		},

		"new": {
			"match": "\\b(new)\\s+([A-Za-z_][A-Za-z0-9_]*)",
			"captures": {
				"1": { "name": "keyword.operator.new.ghost" },
				"2": { "name": "entity.name.type.class.ghost" }
			}
		},

		"function-declaration": {
			"comment": "function name(a, b = 1) — the name is optional, giving anonymous functions.",
			"begin": "\\b(function)\\b(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?\\s*(?=\\()",
			"beginCaptures": {
				"1": { "name": "storage.type.function.ghost" },
				"2": { "name": "entity.name.function.ghost" }
			},
			"end": "(?<=\\))",
			"patterns": [
				{ "include": "#parameters" }
			]
		},

		"method-declaration": {
			"comment": "Shorthand method in a class or trait body: name(a, b) {. The lookahead rules out control-flow statements, which share the shape.",
			"begin": "^\\s*(?!(?:if|else|for|while|switch|case|default|function|class|trait|return|import|from|as|use|new|in|and|or|break|continue|print|type)\\b)([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\([^()]*\\)\\s*\\{)",
			"beginCaptures": {
				"1": { "name": "entity.name.function.method.ghost" }
			},
			"end": "(?<=\\))",
			"patterns": [
				{ "include": "#parameters" }
			]
		},

		"parameters": {
			"begin": "\\(",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.parameters.begin.ghost" }
			},
			"end": "\\)",
			"endCaptures": {
				"0": { "name": "punctuation.definition.parameters.end.ghost" }
			},
			"patterns": [
				{ "include": "#comments" },
				{
					"comment": "A parameter with a default value.",
					"match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
					"captures": {
						"1": { "name": "variable.parameter.ghost" },
						"2": { "name": "keyword.operator.assignment.ghost" }
					}
				},
				{ "include": "#strings" },
				{ "include": "#constants" },
				{ "include": "#numbers" },
				{
					"name": "variable.parameter.ghost",
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
				},
				{ "include": "#operators" },
				{ "include": "#punctuation" }
			]
		},

		"switch": {
			"patterns": [
				{
					"name": "keyword.control.switch.ghost",
					"match": "\\b(switch)\\b"
				},
				{
					"name": "keyword.control.case.ghost",
					"match": "\\b(case|default)\\b"
				}
			]
		},

		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.conditional.ghost",
					"match": "\\b(if|else)\\b"
				},
				{
					"name": "keyword.control.loop.ghost",
					"match": "\\b(for|while|in)\\b"
				},
				{
					"name": "keyword.control.flow.ghost",
					"match": "\\b(break|continue|return)\\b"
				},
				{
					"name": "variable.language.this.ghost",
					"match": "\\b(this)\\b"
				},
				{
					"name": "variable.language.super.ghost",
					"match": "\\b(super)\\b"
				},
				{
					"name": "storage.type.function.ghost",
					"match": "\\b(function)\\b"
				},
				{
					"name": "storage.type.class.ghost",
					"match": "\\b(class|trait)\\b"
				},
				{
					"name": "storage.modifier.extends.ghost",
					"match": "\\b(extends)\\b"
				},
				{
					"name": "keyword.control.import.ghost",
					"match": "\\b(import|from|as|use)\\b"
				},
				{
					"name": "keyword.operator.new.ghost",
					"match": "\\b(new)\\b"
				}
			]
		},

		"constants": {
			"patterns": [
				{
					"name": "constant.language.null.ghost",
					"match": "\\b(null)\\b"
				},
				{
					"name": "constant.language.boolean.ghost",
					"match": "\\b(true|false)\\b"
				}
			]
		},

		"numbers": {
			"comment": "The scanner reads digits, an optional fractional part, and an optional exponent. There are no hex, octal, or binary literals.",
			"patterns": [
				{
					"name": "constant.numeric.decimal.ghost",
					"match": "\\b[0-9]+(\\.[0-9]+)?([eE]-?[0-9]+)?\\b"
				}
			]
		},

		"library": {
			"patterns": [
				{
					"comment": "Global functions registered by the interpreter.",
					"name": "support.function.builtin.ghost",
					"match": "\\b(type)\\b(?=\\s*\\()"
				},
				{
					"comment": "Standard library modules, only where used as a receiver.",
					"name": "support.class.module.ghost",
					"match": "\\b(console|date|file|ghost|http|json|math|os|path|random)\\b(?=\\s*\\.)"
				}
			]
		},

		"function-call": {
			"patterns": [
				{
					"comment": "obj.method(...)",
					"match": "(?<=\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
					"captures": {
						"1": { "name": "entity.name.function.member.ghost" }
					}
				},
				{
					"comment": "name(...)",
					"match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
					"captures": {
						"1": { "name": "entity.name.function.ghost" }
					}
				}
			]
		},

		"property-access": {
			"match": "(?<=\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\b",
			"captures": {
				"1": { "name": "variable.other.property.ghost" }
			}
		},

		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.spread.ghost",
					"match": "\\.\\.\\."
				},
				{
					"name": "keyword.operator.range.ghost",
					"match": "\\.\\."
				},
				{
					"name": "keyword.operator.increment.ghost",
					"match": "\\+\\+|--"
				},
				{
					"name": "keyword.operator.assignment.compound.ghost",
					"match": "\\+=|-=|\\*=|/="
				},
				{
					"name": "keyword.operator.comparison.ghost",
					"match": "==|!=|<=|>="
				},
				{
					"name": "keyword.operator.relational.ghost",
					"match": "<|>"
				},
				{
					"name": "keyword.operator.logical.ghost",
					"match": "\\b(and|or)\\b|!"
				},
				{
					"name": "keyword.operator.ternary.ghost",
					"match": "\\?"
				},
				{
					"name": "keyword.operator.arithmetic.ghost",
					"match": "\\+|-|\\*|/|%"
				},
				{
					"name": "keyword.operator.assignment.ghost",
					"match": "="
				}
			]
		},

		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.separator.comma.ghost",
					"match": ","
				},
				{
					"name": "punctuation.separator.colon.ghost",
					"match": ":"
				},
				{
					"name": "punctuation.terminator.semicolon.ghost",
					"match": ";"
				},
				{
					"name": "punctuation.accessor.ghost",
					"match": "\\.(?!\\.)"
				},
				{
					"name": "punctuation.section.braces.ghost",
					"match": "[{}]"
				},
				{
					"name": "punctuation.section.brackets.ghost",
					"match": "[\\[\\]]"
				},
				{
					"name": "punctuation.section.parens.ghost",
					"match": "[()]"
				}
			]
		},

		"identifier": {
			"patterns": [
				{
					"comment": "Names in PascalCase are classes and traits by convention.",
					"name": "entity.name.type.ghost",
					"match": "\\b[A-Z][A-Za-z0-9_]*\\b"
				},
				{
					"name": "variable.other.ghost",
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
				}
			]
		}
	}
}
