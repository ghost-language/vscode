{
    "name": "ghost-language",
    "displayName": "Ghost Language",
    "icon": "icon.png",
    "description": "Ghost language support for Visual Studio Code, including the Lumen game engine.",
    "publisher": "GhostLanguage",
    "version": "0.2.0",
    "license": "MIT",
    "keywords": [
        "ghost",
        "ghostlang",
        "lumen",
        "game engine"
    ],
    "bugs": {
        "url": "https://github.com/ghost-language/vscode/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ghost-language/vscode.git"
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./src/extension.js",
    "scripts": {
        "test": "node test/run.js"
    },
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": true,
            "description": "This extension only reads the documents you have open. It runs no project code and no external tools."
        },
        "virtualWorkspaces": true
    },
    "contributes": {
        "configuration": {
            "title": "Ghost",
            "properties": {
                "ghost.lumen.enable": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "markdownDescription": "Include the [Lumen](https://github.com/ghost-language/lumen) game engine's modules, objects and callbacks in completion, hover and highlighting.\n\nA Lumen game is written in Ghost, so there is no separate file type to switch on. Turn this off in a project that is plain Ghost, and names like `window`, `image` and `canvas` will be left alone."
                }
            }
        },
        "languages": [
            {
                "id": "ghost",
                "aliases": [
                    "Ghost",
                    "ghost"
                ],
                "extensions": [
                    ".ghost"
                ],
                "configuration": "./ghost.configuration.json",
                "icons": {
                    "light": "./icons/ghost-light.svg",
                    "dark": "./icons/ghost-dark.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "ghost",
                "scopeName": "source.ghost",
                "path": "./syntaxes/ghost.tmLanguage.json"
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "ghost",
                "scopes": {
                    "namespace.defaultLibrary": [
                        "support.class.module.ghost"
                    ],
                    "method.defaultLibrary": [
                        "support.function.ghost"
                    ],
                    "property.defaultLibrary": [
                        "support.variable.property.ghost"
                    ],
                    "function.defaultLibrary": [
                        "support.function.builtin.ghost"
                    ],
                    "event.defaultLibrary": [
                        "support.function.callback.ghost"
                    ]
                }
            }
        ]
    }
}
